# ================= SHOPKART BACKEND ENV =================
# MongoDB Connection (local MongoDB instance)
MONGODB_URI=mongodb://127.0.0.1:27017/shopkart

# For MongoDB Atlas (cloud), use this format instead:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shopkart

# JWT Secret (signs login tokens - keep this secure in production)
# Generate a random string: https://www.random.org/strings/
JWT_SECRET=your_jwt_secret_key_here_change_for_production

# Server Port (optional, defaults to 5000)
PORT=5000

# ================= RAZORPAY TEST MODE =================
# IMPORTANT: Use ONLY TEST MODE keys here. NEVER paste LIVE keys.
# Get these from: https://dashboard.razorpay.com/ (switch to TEST mode, top-left)
#
# Razorpay Test Key ID (starts with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Test Key Secret
RAZORPAY_KEY_SECRET=your_key_secret_here
